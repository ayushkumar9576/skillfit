# ---------------------------------------------------------------------------
# SkillFit backend — environment configuration template.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
#
# NEVER commit the real `.env` — it contains secrets.
# ---------------------------------------------------------------------------

# --- Database (Phase 1+) ---
DATABASE_URL=postgresql://user:password@localhost:5432/skillfit
ENV=development

# --- LLM Integration Layer (Phase 3.6) ---
# Generic, provider-independent runtime settings. Renaming the provider later
# (Azure OpenAI / Anthropic / Gemini) does not require analyzer changes.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# Optional per-call output-token budget for analysis engines.
# When unset, the Phase 3.7 Project Analysis Engine uses a default of 8000.
# That is HEADROOM, not a target: the engine's compact wire schema (evidence
# cited by resume line number, no derived fields, one merged skills/tech array)
# brings a full 16-area project report in at roughly 1000-1500 completion
# tokens, so the default leaves ~5x slack for an unusually rich project.
#
# Set this to raise or lower the budget without touching code; a per-call
# `max_tokens` argument still overrides it. (Read via os.getenv, so it is NOT
# part of LLMSettings.)
#
# If you see a WARNING that a response "hit the output-token cap", the report
# was salvaged as a partial (every schema field is optional-with-default) — raise
# this value rather than ignoring it. Truncation is deliberately NOT retried:
# temperature is 0, so a second call would truncate at the identical point.
# Lowering it below ~2000 makes partial reports likely.
# LLM_MAX_TOKENS=8000

# Provider-specific credential. Read directly by the OpenAI provider.
# Required only when the LLM service is actually constructed/used —
# app boot and existing tests do NOT require it (lazy validation).
OPENAI_API_KEY=

# Optional: route the OpenAI provider through any OpenAI-COMPATIBLE gateway
# (AgentRouter, OpenRouter-style services, AI-Studio gateways, Azure-compatible
# proxies, a local proxy). Leave unset to use the official OpenAI API
# (https://api.openai.com/v1). When set, keep LLM_PROVIDER=openai — no new
# provider class is needed — choose the gateway's model via LLM_MODEL and its
# key via OPENAI_API_KEY. Read directly by the OpenAI provider (like
# OPENAI_API_KEY), so it is NOT part of LLMSettings.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
